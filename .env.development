# Environment: Development
# EdgeWatch Platform (ASP.NET Core) — run it with `dotnet run` in edgewatch-platform
VITE_EDGEWATCH_API_URL="http://localhost:5262/api/v1"
# Fake API (json-server) — only for bounded contexts not yet in the platform (billing)
VITE_MOCK_API_URL="http://localhost:3000/api/v1"
VITE_USERS_ENDPOINT_PATH="/users"
VITE_TOKENS_ENDPOINT_PATH="/tokens"
VITE_ROLES_ENDPOINT_PATH="/roles"
VITE_ORGANIZATIONS_ENDPOINT_PATH="/organizations"
VITE_PLANS_ENDPOINT_PATH="/plans"
VITE_SUBSCRIPTIONS_ENDPOINT_PATH="/subscriptions"
VITE_CUSTOMERS_ENDPOINT_PATH="/customers"
VITE_COMPONENTS_ENDPOINT_PATH="/components"
VITE_RECUPERATIONS_ENDPOINT_PATH="/recuperations"
VITE_HVOF_SYSTEMS_ENDPOINT_PATH="/hvof-systems"
VITE_RECIPES_ENDPOINT_PATH="/recipes"
VITE_SPRAY_SESSIONS_ENDPOINT_PATH="/spray-sessions"
VITE_FAULT_CASES_ENDPOINT_PATH="/fault-cases"
VITE_FAULT_RULES_ENDPOINT_PATH="/fault-rules"
